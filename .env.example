# ════════════════════════════════════════════════════════════════
#  Alba PIP — Environment Variables
#  Copy this file to .env (local) OR add these in Vercel:
#  Vercel → Project → Settings → Environment Variables
#  Adding a key flips that feed from SIMULATED to LIVE. No code changes.
# ════════════════════════════════════════════════════════════════

# ── AI AGENTS ────────────────────────────────────────────────────
# Get a key at console.anthropic.com. Powers investigation, Q&A,
# board pack agents. Without it, agents use pre-written narratives.
VITE_ANTHROPIC_API_KEY=

# ── MARKET DATA ──────────────────────────────────────────────────
# FX rates use ExchangeRate-API (free, no key) by default — already LIVE.
# Add an Alpha Vantage key (free at alphavantage.co) for index/quote data.
VITE_ALPHA_VANTAGE_KEY=

# ── COMPANY NEWS ─────────────────────────────────────────────────
# Get a free developer key at newsapi.org.
# NOTE: NewsAPI free tier serves live results on localhost only.
# On the deployed site, live news needs the serverless proxy or a paid plan.
VITE_NEWSAPI_KEY=

# ── XERO (accounting integration) ────────────────────────────────
# From your Xero app at developer.xero.com → Configuration.
# These go in VERCEL → Settings → Environment Variables (NOT in frontend code).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://alba-pip.vercel.app/api/xero/callback
